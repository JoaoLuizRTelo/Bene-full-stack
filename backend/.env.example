# Copie para .env e preencha os valores. O .env NAO vai para o repositorio.

NODE_ENV=development
PORT=3000

# Banco de dados
# Local (docker compose up -d na raiz):
DATABASE_URL=postgres://ditado:ditado@127.0.0.1:5432/ditado
# Neon ou outro banco gerenciado: cole a connection string acima e ligue o SSL
DATABASE_SSL=false

# Autenticacao - gere um valor longo e aleatorio, NAO use este texto
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Transcricao: mock (nao precisa de chave) ou groq
TRANSCRIPTION_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Limite de tamanho do audio, em MB (25 e o limite da camada gratuita da Groq)
MAX_UPLOAD_MB=25

# Usadas apenas por "npm run seed:admin"
ADMIN_EMAIL=admin@ditado.dev
ADMIN_PASSWORD=
